# Everything is simulated: market feed, broker accounts and orders. No credentials needed.
DATABASE_URL=sqlite:///./arbitrage.db
# Virtual capital, split equally between the two simulated broker accounts
STARTING_CAPITAL=1000000
# Probability a limit order loses the race for liquidity (0-1)
FILL_COMPETITION=0.12
# Simulate occasional feed disconnects to show reconnect handling (1/0)
SIM_DISCONNECTS=1
